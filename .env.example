# ====================== Server Configuration ======================
# Server host address, e.g., 0.0.0.0 or 127.0.0.1
HOST=0.0.0.0
# Server port, default 5000
PORT=5000

# ====================== Database Configuration ======================
# Database host, e.g., localhost or 127.0.0.1
DB_HOST=your_db_host
# Database port, default 3306
DB_PORT=3306
# Database username
DB_USER=your_db_user
# Database password
DB_PASSWORD=your_db_password
# Database name
DB_NAME=your_db_name
# Database charset, recommended utf8mb4 for emoji compatibility
DB_CHARSET=utf8mb4
# Database type: mysql or postgresql
DB_DIALECT=postgresql

# ======================= LLM Configuration =======================
# You can change the LLM API for each component. Any provider compatible with OpenAI request format will work.
# Just define KEY, BASE_URL, and MODEL_NAME correctly.
# Recommended default profile from api_evaluation/results_full_r3:
# - QueryEngine LLM: deepseek-chat
# - MediaEngine LLM: qwen-plus-compatible / DashScope compatible qwen-plus
# - ReportEngine LLM: deepseek-chat
# - MindSpider LLM: qwen-plus-compatible / DashScope compatible qwen-plus
# - Search: TavilyAPI
# Simpler low-latency profile: deepseek-chat for all LLM engines and TavilyAPI for search.
# Start with one of these profiles before changing providers.

# Insight Agent (optional legacy path; set only if you use the legacy insight workflow)
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=
INSIGHT_ENGINE_MODEL_NAME=

# Media Agent (recommended qwen-plus-compatible / DashScope compatible qwen-plus)
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEDIA_ENGINE_MODEL_NAME=qwen-plus

# Query Agent (recommended deepseek-chat, official: https://platform.deepseek.com/)
QUERY_ENGINE_API_KEY=
QUERY_ENGINE_BASE_URL=https://api.deepseek.com
QUERY_ENGINE_MODEL_NAME=deepseek-chat

# Coordinator runtime provider profile.
# If these are blank, the artifact will explicitly mark the provider as not_configured.
JINA_API_KEY=
JINA_EMBEDDING_BASE_URL=https://api.jina.ai/v1/embeddings
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSIONS=
JINA_RERANK_BASE_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v3
COORDINATOR_ENABLE_MINDSPIDER_DB=false
COORDINATOR_ENABLE_MEDIA_AGENT=true
COORDINATOR_ALLOW_MINDSPIDER_CRAWL_TRIGGER=false
COORDINATOR_ALLOW_REPLAY_FALLBACK=false
COORDINATOR_MAX_RESEARCH_ROUNDS=1
COORDINATOR_MAX_EMBEDDING_ITEMS=120
COORDINATOR_MAX_RERANK_DOCUMENTS=40
COORDINATOR_PROVIDER_TIMEOUT=30
COORDINATOR_SEMANTIC_DUPLICATE_THRESHOLD=0.92

# Report Agent (recommended deepseek-chat, official: https://platform.deepseek.com/)
# Note: Report Agent requires a relatively capable model. If charts are blank or paragraphs are abnormal, try a stronger model.
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=https://api.deepseek.com
REPORT_ENGINE_MODEL_NAME=deepseek-chat
# Report output language: en (English-only, default) or zh
# Also applies to QueryEngine/MediaEngine forum summaries and report structure when en
REPORT_OUTPUT_LANGUAGE=en
# Translate Chinese Query/Media/forum inputs to English before report generation (when en)
REPORT_TRANSLATE_INPUT_TO_EN=true

# MindSpider Agent (recommended qwen-plus-compatible / DashScope compatible qwen-plus)
MINDSPIDER_API_KEY=
MINDSPIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINDSPIDER_MODEL_NAME=qwen-plus

# Forum Host (recommended qwen-plus, official: https://www.aliyun.com/product/bailian)
FORUM_HOST_API_KEY=
FORUM_HOST_BASE_URL=
FORUM_HOST_MODEL_NAME=

# SQL Keyword Optimizer (recommended qwen-plus, official: https://www.aliyun.com/product/bailian)
KEYWORD_OPTIMIZER_API_KEY=
KEYWORD_OPTIMIZER_BASE_URL=
KEYWORD_OPTIMIZER_MODEL_NAME=

# ================== Pipeline Performance Tuning ====================
# Max chars per search snippet in LLM prompts (default 50000)
# SEARCH_CONTENT_MAX_LENGTH=50000
# MediaEngine: parallel paragraph workers (1=sequential, 3 recommended)
# MEDIA_PARAGRAPH_WORKERS=3
# Extra sequential retry passes for paragraphs that need a second pass after parallel processing (default 1)
# MEDIA_PARAGRAPH_RETRY_PASSES=1
# MediaEngine: cap reflection-summary context size (default 50000)
# MEDIA_REFLECTION_STATE_MAX_CHARS=50000
# MediaEngine: use direct report assembly for throughput (default false)
# MEDIA_USE_LLM_REPORT_FORMAT=false
# LLM HTTP timeouts (seconds): short tasks vs streaming summaries
# LLM_SHORT_TASK_TIMEOUT=120
# LLM_LONG_TASK_TIMEOUT=600
# Abort streaming when the idle window is exceeded (default 240)
# LLM_STREAM_IDLE_TIMEOUT=240
# MEDIA_ENGINE_REQUEST_TIMEOUT=600
# QUERY_ENGINE_REQUEST_TIMEOUT=600
# REPORT_ENGINE_REQUEST_TIMEOUT=1200
# Media/Bocha search HTTP timeout (seconds)
# MEDIA_SEARCH_HTTP_TIMEOUT=60
# Coordinator wall-clock budgets (seconds)
# COORDINATOR_MEDIA_AGENT_TIMEOUT=10800
# COORDINATOR_QUERY_AGENT_TIMEOUT=1800
# QueryEngine: max gap-fill search rounds (default 2)
# QUERY_MAX_SEARCH_ITERATIONS=2

# ================== Network Tools Configuration ====================
# Tavily API key for web search, apply at: https://www.tavily.com/
TAVILY_API_KEY=

# Web search tool type: TavilyAPI, BochaAPI, or AnspireAPI. TavilyAPI is the default Coordinator profile.
SEARCH_TOOL_TYPE=TavilyAPI

# Anspire AI Search API (apply at: https://open.anspire.cn/?share_code=3E1FUOUH)
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_API_KEY=

# Bocha AI Search API (apply at: https://open.bochaai.com/)
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search
BOCHA_WEB_SEARCH_API_KEY=
