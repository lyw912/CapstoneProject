@direction LR
@spacing 90

(Topic) -> [Home\nrun analysis]
[Home\nrun analysis] -> [Readout\nsignal + tensions]
[Readout\nsignal + tensions] -> [Proof\nevidence + divergence]
[Proof\nevidence + divergence] -> [Edit\ngenerate + annotate]
[Edit\ngenerate + annotate] -> [Revision Request\nsave or rerun]
[Revision Request\nsave or rerun] -> [Monitor\ntrace + quality]
[Monitor\ntrace + quality] -> (Report)
